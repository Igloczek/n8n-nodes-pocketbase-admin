{
	"name": "n8n-nodes-pocketbase-admin",
	"version": "3.0.0",
	"description": "Interact with your PocketBase instance as admin",
	"keywords": [
		"n8n-community-node-package"
	],
	"license": "MIT",
	"homepage": "https://github.com/igloczek/n8n-nodes-pocketbase-admin#readme",
	"author": {
		"name": "Bartek Igielski",
		"email": "igloczek@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/igloczek/n8n-nodes-pocketbase-admin.git"
	},
	"engines": {
		"node": ">=18.10",
		"pnpm": ">=9.1"
	},
	"packageManager": "pnpm@9.1.4",
	"main": "index.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "oxfmt nodes credentials",
		"lint": "oxlint nodes credentials",
		"lintfix": "oxlint nodes credentials --fix",
		"prepublishOnly": "pnpm build && pnpm lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/PocketBaseAdminApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PocketBaseAdmin/PocketBaseAdmin.node.js"
		]
	},
	"dependencies": {
		"pocketbase": "^0.28.1"
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.37.0",
		"@types/node": "^24.19.2",
		"eslint-plugin-n8n-nodes-base": "^2.0.0",
		"gulp": "^5.0.1",
		"n8n-workflow": "*",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
